# Copy this file to ".env" (same folder) and fill in your own values
# from Supabase: Settings -> Data API (for the URL) and Settings -> API Keys
# (for the publishable key). Never put the "secret key" here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
